# Supabase (Fase 2) — valores do painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# IA avançada (opcional). Somente no servidor — nunca NEXT_PUBLIC_.
# Chave da API da Anthropic (console.anthropic.com). Sem ela, a assistente funciona só no modo local.
AI_API_KEY=
# Modelo (padrão: claude-haiku-5-5, o de menor custo)
AI_MODEL=
