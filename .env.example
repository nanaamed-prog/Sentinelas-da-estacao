# Supabase (Fase 2) — valores do painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# IA avançada (opcional). Somente no servidor — nunca NEXT_PUBLIC_.
# Chave da API da Anthropic (console.anthropic.com). Sem ela, a assistente funciona só no modo local.
AI_API_KEY=
# Modelo (padrão: claude-haiku-5-5, o de menor custo)
AI_MODEL=

# Assinaturas (Stripe) — SOMENTE NO SERVIDOR. Nunca prefixar com NEXT_PUBLIC_.
# Comece com as chaves de TESTE (sk_test_...): nenhum valor real é cobrado.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...), em Stripe > Desenvolvedores > Webhooks
STRIPE_WEBHOOK_SECRET=
# Endereço público do app, para os retornos do checkout (ex.: https://sentinelas-da-estacao.vercel.app)
APP_URL=
# Reembolso total encerra o acesso na hora (padrão: sim). Use "nao" para manter até o fim do período.
REEMBOLSO_TOTAL_ENCERRA=
